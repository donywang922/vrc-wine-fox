import bpy

def split_mesh_by_vertex_groups():
    obj = bpy.context.active_object

    # 检查是否选择了网格物体且包含顶点组
    if not obj or obj.type != 'MESH' or not obj.vertex_groups:
        print("错误：请先选择一个带有顶点组的网格物体。")
        return

    # 确保在开始操作前处于对象模式
    if bpy.context.object.mode != 'OBJECT':
        bpy.ops.object.mode_set(mode='OBJECT')

    original_name = obj.name
    # 提前获取所有顶点组的名称，避免在循环中结构发生改变
    vg_names = [vg.name for vg in obj.vertex_groups]

    for vg_name in vg_names:
        # 重置选择，确保仅原物体处于活动并选中状态
        bpy.ops.object.select_all(action='DESELECT')
        obj.select_set(True)
        bpy.context.view_layer.objects.active = obj
        
        # 进入编辑模式并取消所有顶点的选择
        bpy.ops.object.mode_set(mode='EDIT')
        bpy.ops.mesh.select_all(action='DESELECT')
        
        # 激活当前循环的顶点组并选中其顶点
        vg_idx = obj.vertex_groups.find(vg_name)
        obj.vertex_groups.active_index = vg_idx
        bpy.ops.object.vertex_group_select()
        
        # 尝试分离选中的顶点
        try:
            bpy.ops.mesh.separate(type='SELECTED')
        except RuntimeError:
            # 如果该组没有顶点，或者顶点已经在上一次循环中被其他组分走，这里会报错
            # 我们直接忽略它，切回对象模式并继续下一个组
            bpy.ops.object.mode_set(mode='OBJECT')
            continue
        
        # 回到对象模式处理分离出的新物体
        bpy.ops.object.mode_set(mode='OBJECT')
        
        # 分离操作后，原物体和新物体都会被选中。找出新物体并重命名。
        for new_obj in bpy.context.selected_objects:
            if new_obj != obj:
                new_obj.name = f"{vg_name}"
                new_obj.select_set(False)

    print("网格拆分完成！")

# 运行函数
split_mesh_by_vertex_groups()