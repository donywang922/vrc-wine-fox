v.sleep_random=v.sleep_Constant>0?0:v.sleep_random;




v.sleep_extra1=((v.sleep_random==1?1:0)||(v.sleep_Constant==1?1:0))&&ctrl.playing_extra_animation;
v.sleep_extra2=((v.sleep_random==2?1:0)||(v.sleep_Constant==2?1:0))&&ctrl.playing_extra_animation;
v.sleep_extra3=((v.sleep_random==3?1:0)||(v.sleep_Constant==3?1:0))&&ctrl.playing_extra_animation;
v.sleep_extra4=((v.sleep_random==4?1:0)||(v.sleep_Constant==4?1:0))&&ctrl.playing_extra_animation;
v.sleep_extra5=((v.sleep_random==5?1:0)||(v.sleep_Constant==5?1:0))&&ctrl.playing_extra_animation;