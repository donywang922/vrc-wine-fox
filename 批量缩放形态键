import bpy

def create_scaled_shape_keys():
    # 获取当前选中的所有网格物体
    selected_meshes = [obj for obj in bpy.context.selected_objects if obj.type == 'MESH']

    if not selected_meshes:
        print("未选中任何网格物体。")
        return

    # 确保在对象模式下操作
    if bpy.context.active_object and bpy.context.active_object.mode != 'OBJECT':
        bpy.ops.object.mode_set(mode='OBJECT')

    for obj in selected_meshes:
        # 清理可能存在的旧形态键，确保生成的基型是绝对的第一顺位
        if obj.data.shape_keys:
            obj.shape_key_clear()

        # 获取物体所在的集合名称，如果不在任何集合中则赋予默认名称
        collection_name = "Default_Collection"
        if obj.users_collection:
            collection_name = obj.users_collection[0].name

        # 1. 创建基型 (Basis)，此时它记录的是网格原始坐标
        sk_basis = obj.shape_key_add(name="Basis")
        
        # 2. 创建目标形态键，此时它也记录了网格原始坐标
        sk_target = obj.shape_key_add(name=collection_name)
        
        # 将目标形态键的权重设为 1.0，防止基型缩小后物体在视口中突然变小
        sk_target.value = 1.0
        
        # 3. 遍历基型的数据，将其顶点坐标向物体原点缩小到 0.01 倍
        for v in sk_basis.data:
            v.co = v.co * 0.01

    print("形态键生成完毕。")

if __name__ == "__main__":
    create_scaled_shape_keys()